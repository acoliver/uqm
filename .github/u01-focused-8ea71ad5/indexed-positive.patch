 #[cfg(test)]
 mod tests {
     use super::*;
+
+    const INDEXED_WAVE: &[u8] = b"RIFF\x26\0\0\0WAVEfmt \x10\0\0\0\x01\0\x01\0\x22\x56\0\0\x22\x56\0\0\x01\0\x08\0data\x02\0\0\0\x80\x81";
+
+    #[test]
+    fn indexed_positive_sound_bank_loads_entries_and_keeps_clips_on_reload() {
+        use crate::resource::AssetKind;
+        use crate::sound::mixer::buffer::{mixer_get_buffer, mixer_is_buffer};
+
+        let _guard = crate::sound::test_support::ENGINE_TEST_LOCK.lock();
+        let mount = crate::io::fixture::TempMount::new();
+        mount.write("sounds.rmp", b"test.bank = SNDRES:sounds/bank.snd\n");
+        mount.write("sounds/bank.snd", b"first.wav\nsecond.wav\n");
+        for name in ["sounds/first.wav", "sounds/second.wav"] {
+            mount.write(name, INDEXED_WAVE);
+        }
+        let content = mount.content(c"sounds.rmp");
+        let resolved = content.resolve(c"test.bank", AssetKind::Sound).unwrap();
+        assert_eq!(resolved.descriptor, "sounds/bank.snd");
+        assert_eq!(resolved.source.index.as_c_str(), c"sounds.rmp");
+        assert_eq!(resolved.revision, content.revision());
+
+        let bank = LoadedSoundBank::load(&content, c"test.bank").unwrap();
+        assert_eq!(bank.len(), 2);
+        let handles: Vec<_> = bank
+            .0
+            .samples
+            .iter()
+            .map(|sample| sample.buffers[0])
+            .collect();
+        for sample in &bank.0.samples {
+            assert_eq!(sample.length, 2.0 / 22050.0);
+            let buffer = mixer_get_buffer(sample.buffers[0]).unwrap();
+            let buffer = buffer.lock();
+            assert_eq!(buffer.org_data.as_deref(), Some([128, 129].as_slice()));
+            assert_eq!(
+                (buffer.org_freq, buffer.org_channels, buffer.org_chansize),
+                (22050, 1, 1)
+            );
+            assert!(!buffer.bytes().is_empty());
+        }
+        let weak = Rc::downgrade(&bank.0);
+        let clip = bank.clip(0);
+        assert_eq!(clip.identity(), bank.clip(2).identity());
+        assert_ne!(clip.identity(), bank.clip(1).identity());
+        drop(bank);
+        assert!(weak.upgrade().is_some());
+        let reloaded = LoadedSoundBank::load(&content, c"test.bank").unwrap();
+        assert_eq!(reloaded.len(), 2);
+        assert_ne!(clip.identity(), reloaded.clip(0).identity());
+        drop(reloaded);
+        drop(content);
+        drop(mount);
+        assert_eq!(clip.bank.0.samples[0].length, 2.0 / 22050.0);
+        let buffer = mixer_get_buffer(handles[0]).unwrap();
+        assert_eq!(
+            buffer.lock().org_data.as_deref(),
+            Some([128, 129].as_slice())
+        );
+        drop(buffer);
+        drop(clip);
+        assert!(weak.upgrade().is_none());
+        assert!(handles.iter().all(|&handle| !mixer_is_buffer(handle)));
+    }
