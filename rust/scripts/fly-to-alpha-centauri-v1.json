{
  "version": 1,
  "name": "fly-to-alpha-centauri-v1",
  "start_save": {
    "path": "saves/allied-starbase.sav",
    "slot": 0
  },
  "budgets": {
    "max_input_ticks": 11100,
    "max_presentations": 22200,
    "max_wallclock_seconds": 600
