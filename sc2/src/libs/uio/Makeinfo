# Export USE_RUST_UIO to Makeinfo's environment
if [ -n "$USE_RUST_UIO" ]; then
	export USE_RUST_UIO
fi

uqm_SUBDIRS="stdio"
uqm_CFILES="defaultfs.c fileblock.c fstypes.c gphys.c io.c
		ioaux.c match.c mount.c mounttree.c physical.c uiostream.c
		utils.c"
uqm_HFILES="charhashtable.h fstypes.h getint.h
		gphys.h io.h iointrn.h match.h mem.h mount.h mounttree.h
		paths.h physical.h types.h uioport.h uiostream.h utils.h"

	# Exclude C UIO sources when Rust implementations are enabled
if [ -n "$USE_RUST_UIO" ]; then
	uqm_CFILES=""
	uqm_HFILES="charhashtable.h paths.h "
	uqm_SUBDIRS=""
fi


