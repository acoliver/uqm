+        for _ in 0..2 {
+            let music = LoadedMusic::load(&content, c"test.music").unwrap();
+            let retained = music.playback();
+            let weak = Arc::downgrade(&retained.0);
+            let buffers = {
+                let mut sample = retained.0.lock();
+                assert_eq!(sample.num_buffers, 64);
+                let decoder = sample.decoder.as_mut().unwrap();
+                assert_eq!(decoder.name(), "Wave");
+                assert_eq!(decoder.frequency(), 22050);
+                assert_eq!(decoder.format(), AudioFormat::Mono8);
+                assert_eq!(decoder.length(), 2.0 / 22050.0);
+                let mut pcm = [0; 2];
+                assert_eq!(decoder.decode(&mut pcm).unwrap(), 2);
+                assert_eq!(pcm, [128, 129]);
+                sample.buffers.clone()
+            };
+            drop(music);
+            assert!(weak.upgrade().is_some());
+            {
+                let sample = retained.0.lock();
+                assert!(sample.decoder.is_none());
