    {"action": "tap_player_key", "key": "thrust", "value": 1, "hold": 40, "settle": 10},
    {"action": "capture", "label": "mars-planet-side-moved"},
    {"action": "tap_player_key", "key": "escape", "value": 1, "hold": 1, "settle": 20},
    {"action": "wait_input_ticks", "count": 100},
    {"action": "capture", "label": "mars-orbit-after-takeoff"},
    {"action": "finish"}
