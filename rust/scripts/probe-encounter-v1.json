{
  "version": 1,
  "name": "probe-encounter-v1",
  "budgets": {
    "max_input_ticks": 3830,
    "max_presentations": 5660,
    "max_wallclock_seconds": 240
  },
  "steps": [
    {"action": "wait_for_main_menu_ready"},
    {"action": "tap_menu_key", "key": "down", "value": 1, "hold": 3, "settle": 3},
    {"action": "assert_main_menu_transition", "from": "NewGame", "to": "LoadGame"},
    {"action": "capture", "label": "menu-after-down"},
    {"action": "tap_menu_key", "key": "up", "value": 1, "hold": 3, "settle": 3},
    {"action": "assert_main_menu_transition", "from": "LoadGame", "to": "NewGame"},
    {"action": "tap_menu_key", "key": "select", "value": 1, "hold": 3, "settle": 10},
    {"action": "capture", "label": "menu-after-select-newgame"},
    {"action": "tap_menu_key", "key": "select", "value": 1, "hold": 3, "settle": 10},
    {"action": "wait_input_ticks", "count": 20},
    {"action": "assert_activity", "mask": 255, "equals": 4},
    {"action": "navigate_to_hyperspace", "max_ticks": 1800},
    {"action": "wait_input_ticks", "count": 40},
    {"action": "capture", "label": "hyperspace-start"},
    {"action": "assert_activity", "mask": 255, "equals": 3},
    {"action": "record_hyperspace_position"},
    {"action": "tap_player_key", "key": "thrust", "value": 1, "hold": 100, "settle": 5},
    {"action": "assert_hyperspace_displacement", "minimum_logical_units": 16},
    {"action": "capture", "label": "after-leg-1"},
    {"action": "turn_flagship", "direction": "right", "facings": 4, "max_ticks": 120},
    {"action": "capture", "label": "after-turn-1"},
    {"action": "record_hyperspace_position"},
    {"action": "tap_player_key", "key": "thrust", "value": 1, "hold": 100, "settle": 5},
    {"action": "assert_hyperspace_displacement", "minimum_logical_units": 16},
    {"action": "capture", "label": "after-leg-2"},
    {"action": "turn_flagship", "direction": "right", "facings": 4, "max_ticks": 120},
    {"action": "capture", "label": "after-turn-2"},
    {"action": "record_hyperspace_position"},
    {"action": "tap_player_key", "key": "thrust", "value": 1, "hold": 100, "settle": 5},
    {"action": "assert_hyperspace_displacement", "minimum_logical_units": 16},
    {"action": "capture", "label": "after-leg-3"},
    {"action": "turn_flagship", "direction": "right", "facings": 4, "max_ticks": 120},
    {"action": "capture", "label": "after-turn-3"},
    {"action": "record_hyperspace_position"},
    {"action": "tap_player_key", "key": "thrust", "value": 1, "hold": 100, "settle": 5},
    {"action": "assert_hyperspace_displacement", "minimum_logical_units": 16},
    {"action": "capture", "label": "after-leg-4"},
    {"action": "wait_input_ticks", "count": 100},
    {"action": "assert_activity", "mask": 255, "equals": 4},
    {"action": "capture", "label": "returned-to-sol"},
    {"action": "wait_input_ticks", "count": 50},
    {"action": "capture", "label": "probe-encounter-final"},
    {"action": "finish"}
  ]
}
