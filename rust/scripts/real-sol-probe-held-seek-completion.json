    {"action": "wait_input_ticks", "count": 10},
    {"action": "tap_menu_key", "key": "select", "value": 1, "hold": 3, "settle": 15},
    {"action": "wait_input_ticks", "count": 20},
    {"action": "assert_activity", "mask": 255, "equals": 4},
    {"action": "navigate_to_planet", "planet": 2, "max_ticks": 1800},
    {"action": "wait_input_ticks", "count": 200},
    {"action": "assert_dispatch", "encounter": 24, "dialogue": 18},
    {"action": "capture", "label": "real-probe-held-seek-broadcast"},
    {"action": "set_menu_key", "key": "left", "value": 1},
    {"action": "wait_input_ticks", "count": 30},
    {"action": "tap_menu_key", "key": "cancel", "value": 1, "hold": 2, "settle": 4},
    {"action": "wait_for_communication_end", "minimum_completions": 1, "max_ticks": 5000},
    {"action": "set_menu_key", "key": "left", "value": 0},
    {"action": "assert_activity", "mask": 255, "equals": 4},
    {"action": "capture", "label": "real-probe-held-seek-returned-to-flight"},
    {"action": "finish"}
