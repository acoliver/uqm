{
 "version": 1,
 "name": "quit-v1",
 "budgets": {
  "max_input_ticks": 400,
  "max_presentations": 400,
  "max_wallclock_seconds": 60
 },
 "steps": [
  {
   "action": "wait_input_ticks",
   "count": 10
  },
  {
   "action": "tap_menu_key",
   "key": "down",
   "value": 1,
   "hold": 3,
   "settle": 3
  },
  {
   "action": "assert_main_menu_transition",
   "from": "NewGame",
   "to": "LoadGame"
  },
  {
   "action": "tap_menu_key",
   "key": "down",
   "value": 1,
   "hold": 3,
   "settle": 3
  },
  {
   "action": "assert_main_menu_transition",
   "from": "LoadGame",
   "to": "SuperMelee"
  },
  {
   "action": "tap_menu_key",
   "key": "down",
   "value": 1,
   "hold": 3,
   "settle": 3
  },
  {
   "action": "assert_main_menu_transition",
   "from": "SuperMelee",
   "to": "Setup"
  },
  {
   "action": "tap_menu_key",
   "key": "down",
   "value": 1,
   "hold": 3,
   "settle": 3
  },
  {
   "action": "assert_main_menu_transition",
   "from": "Setup",
   "to": "Quit"
  },
  {
   "action": "capture",
   "label": "menu-on-quit"
  },
  {
   "action": "assert_mode",
   "mode": "main_menu"
  },
  {
   "action": "finish"
  }
 ]
}