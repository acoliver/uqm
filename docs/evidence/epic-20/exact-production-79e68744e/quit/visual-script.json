{
  "version": 1,
  "name": "quit-diagnostic",
  "budgets": {
    "max_input_ticks": 2000,
    "max_presentations": 2000,
    "max_wallclock_seconds": 180
  },
  "steps": [
    {"action":"wait_input_ticks","count":10},
    {"action":"tap_menu_key","key":"select","value":1,"hold":3,"settle":15},
    {"action":"wait_input_ticks","count":30},
    {"action":"tap_menu_key","key":"cancel","value":1,"hold":1,"settle":10},
    {"action":"tap_menu_key","key":"up","value":1,"hold":1,"settle":10},
    {"action":"tap_menu_key","key":"up","value":1,"hold":1,"settle":10},
    {"action":"tap_menu_key","key":"select","value":1,"hold":1,"settle":10},
    {"action":"capture","label":"game-options"},
    {"action":"tap_menu_key","key":"down","value":1,"hold":1,"settle":5},
    {"action":"tap_menu_key","key":"down","value":1,"hold":1,"settle":5},
    {"action":"capture","label":"in-game-quit-selected"},
    {"action":"tap_menu_key","key":"select","value":1,"hold":1,"settle":10},
    {"action":"tap_menu_key","key":"right","value":1,"hold":1,"settle":10},
    {"action":"capture","label":"in-game-quit-confirm-yes"},
    {"action":"tap_menu_key","key":"select","value":1,"hold":1,"settle":30},
    {"action":"capture","label":"returned-title-menu"},
    {"action":"tap_menu_key","key":"up","value":1,"hold":1,"settle":10},
    {"action":"capture","label":"title-quit-selected"},
    {"action":"tap_menu_key","key":"select","value":1,"hold":1,"settle":10},
    {"action":"finish"}
  ]
}
