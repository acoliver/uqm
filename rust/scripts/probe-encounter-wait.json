{
  "version": 1,
  "name": "probe-encounter-wait",
  "budgets": {
    "max_input_ticks": 10000,
    "max_presentations": 10000,
    "max_wallclock_seconds": 120
  },
  "steps": [
    {"action": "wait_input_ticks", "count": 10},
    {"action": "tap_menu_key", "key": "down", "value": 1, "hold": 3, "settle": 3},
    {"action": "tap_menu_key", "key": "select", "value": 1, "hold": 3, "settle": 10},
    {"action": "tap_menu_key", "key": "select", "value": 1, "hold": 3, "settle": 15},
    {"action": "capture", "label": "at-starbase"},
    {"action": "tap_menu_key", "key": "down", "value": 1, "hold": 3, "settle": 3},
    {"action": "tap_menu_key", "key": "down", "value": 1, "hold": 3, "settle": 3},
    {"action": "tap_menu_key", "key": "down", "value": 1, "hold": 3, "settle": 3},
    {"action": "tap_menu_key", "key": "select", "value": 1, "hold": 3, "settle": 15},
    {"action": "capture", "label": "departed-starbase"},
    {"action": "wait_input_ticks", "count": 5000},
    {"action": "capture", "label": "after-long-wait"},
    {"action": "finish"}
  ]
}
