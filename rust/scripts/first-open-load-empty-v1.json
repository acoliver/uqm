{
  "version": 1,
  "name": "first-open-load-empty-v1",
  "budgets": {
    "max_input_ticks": 300000,
    "max_presentations": 600000,
    "max_wallclock_seconds": 120
  },
  "steps": [
    {
      "action": "wait_for_main_menu_ready"
    },
    {
      "action": "tap_menu_key",
      "key": "down",
      "value": 1,
      "hold": 3,
      "settle": 5
    },
    {
      "action": "tap_menu_key",
      "key": "select",
      "value": 1,
      "hold": 3,
      "settle": 15
    },
    {
      "action": "capture",
      "label": "first-open-empty-load-list"
    },
    {
      "action": "wait_input_ticks",
      "count": 30
    },
    {
      "action": "tap_menu_key",
      "key": "select",
      "value": 1,
      "hold": 3,
      "settle": 30
    },
    {
      "action": "capture",
      "label": "empty-selection-remains-open"
    },
    {
      "action": "tap_menu_key",
      "key": "cancel",
      "value": 1,
      "hold": 3,
      "settle": 30
    },
    {
      "action": "assert_mode",
      "mode": "main_menu"
    },
    {
      "action": "capture",
      "label": "main-after-empty-cancel"
    },
    {
      "action": "tap_menu_key",
      "key": "select",
      "value": 1,
      "hold": 3,
      "settle": 30
    },
    {
      "action": "capture",
      "label": "reopened-empty-load-list"
    },
    {
      "action": "tap_menu_key",
      "key": "cancel",
      "value": 1,
      "hold": 3,
      "settle": 30
    },
    {
      "action": "assert_mode",
      "mode": "main_menu"
    },
    {
      "action": "finish"
    }
  ]
}
