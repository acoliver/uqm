    {"action": "wait_for_communication_end", "minimum_completions": 1, "max_ticks": 9000},
    {"action": "navigate_to_moon", "planet": 2, "moon": 0, "max_ticks": 2000},
    {"action": "wait_for_dispatch", "encounter": 2, "dialogue": 2, "max_ticks": 2000},
    {"action": "select_communication_response", "index": 0, "max_ticks": 5000},
    {"action": "select_communication_response", "index": 0, "max_ticks": 5000},
    {"action": "wait_for_communication_end", "minimum_completions": 1, "max_ticks": 5000},
    {"action": "navigate_to_planet", "planet": 3, "max_ticks": 6000},
    {"action": "capture", "label": "mars-reached-after-starbase"},
    {"action": "navigate_to_orbit", "planet": 3, "max_ticks": 6000},
